# Kopieren nach .env und Werte setzen. Niemals committen!

# Passwort für den Zugang zur App (Pflicht)
APP_PASSWORD=bitte-aendern

# KI-Anbieter: mindestens einen Key setzen. Sind beide gesetzt, wählst du den Anbieter im Formular.
# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-HIER-EINTRAGEN
CLAUDE_MODEL=claude-sonnet-5-5

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Limits pro Stunde / Tag für Generierungen
GENERATIONS_PER_HOUR=10
MAX_GENERATIONS_PER_DAY=50

# Login-Schutz: Fehlversuche bis Sperre, Sperrdauer in Minuten
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Domain-Check: Cache-Dauer in Stunden (belegt / frei) und Abstand zwischen RDAP-Abfragen in ms
WHOIS_CACHE_HOURS=24
WHOIS_CACHE_FREE_HOURS=1
DENIC_INTERVAL_MS=2000
VERISIGN_INTERVAL_MS=250

# Hinter Reverse-Proxy (z. B. Caddy auf dem VPS) true lassen
TRUST_PROXY=true

# Port auf dem Host (nur 127.0.0.1), auf den der Reverse-Proxy weiterleitet
HOST_PORT=8787

# Optional (lokal ohne Docker): Datenverzeichnis, statische Dateien, Port
# DATA_DIR=./data
# STATIC_DIR=../web/dist
# PORT=8787
